# Telegram Bot konfiguratsiyasi
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
BOT_USERNAME=Zakirovsfilms_bot
CHANNEL_USERNAME=@ZakirovsKino

# Adminlar ID lari (vergul bilan ajratilgan)
ADMIN_IDS=123456789,987654321

# Ma'lumotlar bazasi (sqlite yoki postgres)
# SQLite uchun (hech qanday tashqi DB o'rnatmasdan birdaniga ishlaydi):
DB_TYPE=sqlite
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# PostgreSQL uchun (misol):
# DB_TYPE=postgres
# DATABASE_URL=postgresql+asyncpg://postgres:parol@localhost:5432/zakirovs_db

# Kinolar zaxira kanali ID (ixtiyoriy, agar kinolarni maxfiy kanalda saqlasangiz)
STORAGE_CHANNEL_ID=

# Yuklab olish sozlamalari
DOWNLOAD_DIR=temp_downloads
MAX_FILE_SIZE_MB=50
RATE_LIMIT_SECONDS=1.0
